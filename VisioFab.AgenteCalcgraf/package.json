{
  "name": "visiofab-agente-calcgraf",
  "version": "0.2.0",
  "private": true,
  "description": "Agente desktop (Electron + TypeScript) que lê o SQL Server do Calcgraf (somente leitura), detecta OPs novas/alteradas e as envia para a API do Vizor.",
  "author": "VisioFab",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "tedious": "^18.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "br.com.vizorerp.agente-calcgraf",
    "productName": "VisioFab Agente Calcgraf",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "dist/**/*",
      "src/ui/**/*",
      "package.json"
    ]
  }
}
